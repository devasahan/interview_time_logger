# Copy this file to .env for local development:  cp .env.example .env
# In production, set these as environment variables on your host instead.

# True only on your own computer. In production leave it unset (or False).
DJANGO_DEBUG=True

# Required when DJANGO_DEBUG=False. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=

# Comma-separated domain names the app is served from (required in production),
# e.g. DJANGO_ALLOWED_HOSTS=timelog.example.com
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Only needed if forms fail with "CSRF verification failed", e.g. https://timelog.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=

# Leave empty to use a local SQLite file (db.sqlite3). In production use Postgres:
#   DATABASE_URL=postgres://user:password@host:5432/dbname
DATABASE_URL=

# Your time zone (decides what "today" and "this week" mean), e.g. America/New_York, Asia/Colombo.
TIME_ZONE=UTC
# Symbol shown in front of amounts, e.g. $, €, £, Rs.
CURRENCY_SYMBOL=$
# First day of the pay week: 0 = Monday ... 6 = Sunday. Pick this before the first payout.
WEEK_START_DAY=0

# Optional: create the admin account automatically at startup (handy on hosts without a shell).
# An existing account with this username is never changed.
ADMIN_USERNAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
